# ============================================================================
# Wardrowbe 个人 VPS 部署配置（Ollama + 免密登录）
# 由 deploy.sh 自动生成 .env，强密钥位会被脚本替换
# ============================================================================

# ---------- 数据库 ----------
POSTGRES_USER=wardrobe
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=wardrobe
# 只绑定 loopback，避免公网暴露
POSTGRES_PORT=127.0.0.1:5432
REDIS_PORT=127.0.0.1:6379

# ---------- 后端 ----------
BACKEND_PORT=8000
SECRET_KEY=__SECRET_KEY__
# DEBUG=true 在 docker-compose.override.yml 中强制开启，启用免密登录

# ---------- 前端 ----------
FRONTEND_PORT=3000
# 部署完成后建议改为 http://<服务器IP>:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=__NEXTAUTH_SECRET__

# ---------- AI（Ollama 本地） ----------
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_API_KEY=not-needed
AI_VISION_MODEL=llava:7b
AI_TEXT_MODEL=gemma3:latest
# 本地模型较慢，给足超时
AI_TIMEOUT=300
AI_MAX_RETRIES=3

# ---------- 通知（可选） ----------
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
MATTERMOST_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
